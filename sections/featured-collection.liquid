<section class="wrap section snap-section">
  <div class="reveal" data-reveal style="display:flex;justify-content:space-between;margin-bottom:14px">
    <p class="kicker">{{ section.settings.heading }}</p>
  </div>
  {% assign col = section.settings.collection %}
  <div class="grid">
    {% if col != blank and col.products_count > 0 %}
      {% for product in col.products limit: section.settings.limit %}
        <a class="card reveal" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms" href="{{ product.url }}">
          <div class="media">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', decoding: 'async', widths: '360, 540, 720', sizes: '(min-width: 900px) 25vw, 50vw', alt: product.title }}
            {% else %}
              Photo
            {% endif %}
          </div>
          <div class="meta"><div>{{ product.title }}</div><div class="price">{{ product.price | money }}</div></div>
        </a>
      {% endfor %}
    {% else %}
      {% assign shots = "overlap.webp|Overlap,gothic.webp|Gothic,bow.webp|2022" | split: "," %}
      {% for shot in shots %}
        {% assign bits = shot | split: "|" %}
        <div class="card reveal" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 90 }}ms">
          <div class="media"><img class="shot" src="{{ bits[0] | asset_url }}" alt="{{ bits[1] | escape }}"></div>
          <div class="meta"><div>{{ bits[1] }}</div><div class="price">Set price in Shopify</div></div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "default": 3, "label": "Products to show" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
