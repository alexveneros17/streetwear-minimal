<section id="about" class="wrap about snap-section">
  <div class="reveal" data-reveal>
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h2 style="font-size:clamp(32px,4vw,48px);font-weight:500;letter-spacing:-.03em;margin-top:10px">{{ section.settings.heading }}</h2>
    <div style="color:#a39e96;line-height:1.7;margin-top:18px">{{ section.settings.text }}</div>
  </div>
  <nav class="about-menu reveal" data-reveal style="--reveal-delay: 120ms">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }} <span>→</span></a>
      {% endfor %}
    {% else %}
      <a href="/pages/our-story">OUR STORY <span>→</span></a>
      <a href="/pages/social-media">SOCIAL MEDIA <span>→</span></a>
      <a href="/pages/contact">CONTACT <span>→</span></a>
    {% endif %}
  </nav>
</section>
{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "About" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to be worn, not explained." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Cold Hills is a small clothing label. The pieces stay simple so the cut and the fabric do the talking.</p>" },
    { "type": "link_list", "id": "menu", "label": "About menu" }
  ],
  "presets": [{ "name": "About" }]
}
{% endschema %}
