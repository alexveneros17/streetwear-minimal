<header class="site-header">
  <div class="wrap nav">
    <nav class="nav-links">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.all_products_collection_url }}">Product</a>
      <a href="/pages/our-story">About</a>
    </nav>
    <a class="logo" href="{{ routes.all_products_collection_url }}">{{ section.settings.logo | default: shop.name }}</a>
    <div class="nav-right">
      <div class="cart-wrap">
        <button type="button" class="cart-icon" data-cart-toggle aria-label="Bag, {{ cart.item_count }} items" aria-expanded="false">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 8h12l-1 12H7L6 8z"></path>
            <path d="M9 8a3 3 0 0 1 6 0"></path>
          </svg>
          <span>{{ cart.item_count }}</span>
        </button>
        <div class="cart-panel" data-cart-panel hidden>
          {% if cart.item_count == 0 %}
            <p class="muted">Your bag is empty.</p>
          {% else %}
            {% for item in cart.items %}
              <a class="cart-line" href="{{ item.url }}">
                <span class="cart-thumb">{% if item.image %}{{ item.image | image_url: width: 120 | image_tag: alt: item.product.title, loading: 'lazy' }}{% endif %}</span>
                <span>
                  <span>{{ item.product.title }}</span>
                  <span class="muted">{{ item.variant.title }} · {{ item.final_price | money }}</span>
                </span>
              </a>
            {% endfor %}
          {% endif %}
          <a class="cart-view" href="{{ routes.cart_url }}">View bag</a>
        </div>
      </div>
    </div>
  </div>
  <div class="search-bar">
    <form class="search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" placeholder="Search products" aria-label="Search products" value="{{ search.terms | escape }}">
      <input type="hidden" name="type" value="product">
    </form>
  </div>
</header>
{% schema %}
{ "name": "Header", "settings": [{ "type": "text", "id": "logo", "label": "Logo text", "default": "Cold Hills" }] }
{% endschema %}
<script>
  (function () {
    var btn = document.querySelector("[data-cart-toggle]");
    var panel = document.querySelector("[data-cart-panel]");
    if (!btn || !panel) return;
    btn.addEventListener("click", function () {
      var open = panel.hasAttribute("hidden");
      if (open) panel.removeAttribute("hidden");
      else panel.setAttribute("hidden", "");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
  })();
</script>
